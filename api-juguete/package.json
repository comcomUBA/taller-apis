{
  "name": "backend-typescript-bun",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "module": "server.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run src/cluster.ts",
    "lint": "oxlint --type-aware --import-plugin .",
    "lint:fix": "oxlint --type-aware --import-plugin --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.28",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.21.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
